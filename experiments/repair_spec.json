{
  "version": 4,
  "purpose": "Protocol for the controlled repair experiment.",
  "repair_model": {
    "name": "llama3.1:8b-instruct-q4_K_M",
    "must_match_extraction_digest": true,
    "options": {
      "temperature": 0,
      "seed": 42,
      "num_ctx": 4096,
      "num_predict": 2048
    }
  },
  "input": {
    "source_sentence": true,
    "allowed_relations": true,
    "current_content_graph": true,
    "structured_feedback": true,
    "include_clean_reference_graph": false,
    "include_human_adjudication": false,
    "include_auxiliary_rdf_types": false,
    "include_owl_restrictions": false,
    "include_shacl_shapes": false
  },
  "output": {
    "format": "relation(subject, object)",
    "complete_graph_required": true,
    "explanation_allowed": false,
    "duplicate_handling": "order preserving exact duplicate removal",
    "invalid_relation_policy": "record as output error; do not silently correct",
    "invalid_output_retry": false,
    "truncated_output_policy": "record as output failure"
  },
  "main_validators": [
    "raw_shacl",
    "owl_consistency",
    "grounding_v3"
  ],
  "supplementary_not_used_for_feedback": [
    "shacl_with_pyshacl_owl_rl_inference"
  ],
  "feedback": {
    "initial": "controlled primary modification only",
    "later": [
      "remaining controlled violation",
      "new symbolic violations introduced by repair",
      "new grounding violations not present in clean baseline"
    ],
    "exclude_clean_baseline_grounding_noise": true,
    "use_frozen_grounding_output_without_human_correction": true,
    "combined_feedback": true,
    "fields": [
      "validator",
      "violation_id",
      "error_type",
      "focus",
      "path",
      "message"
    ]
  },
  "rounds": {
    "initial_injected_graph": 0,
    "max_repair_rounds": 5
  },
  "stop_rules": {
    "validated": "no actionable violations remain",
    "stalled": "content triple set and actionable violation identity set are unchanged across two consecutive repair rounds",
    "oscillation": "content graph state and actionable violation set repeat a previous nonadjacent repair round",
    "max_rounds": 5,
    "no_feedback": "no actionable feedback exists at round 0, so no repair request is made",
    "output_failure": "model output cannot be used as a complete repaired graph"
  },
  "outcomes": [
    "end_to_end_target_resolution",
    "target_resolution_given_feedback",
    "reference_recovery",
    "rounds_to_resolution",
    "validated_state",
    "collateral_edits",
    "new_violations",
    "stalled",
    "oscillation",
    "output_failures"
  ],
  "reference_recovery": {
    "definition": "final content triple set equals clean reference content triple set",
    "claim_boundary": "controlled reference recovery, not complete recovery of all source facts"
  },
  "analysis_unit": "controlled case",
  "rq3_separate": true,
  "prompt": {
    "path": "experiments/repair_prompt.txt",
    "sha256": "ac091682d5617765ca963a1541da8ee9ed459f3f78ea417bac4270e1297d36e8",
    "frozen_before_run": true,
    "benchmark_demonstration_included": false,
    "reason_demonstration_removed": "One selected Movie case uses the same sentence as the fixed Movie benchmark demonstration, so the demonstration is omitted for every repair case."
  },
  "allowed_relations": {
    "pinned_domain_relations": true,
    "controlled_temporal_relations_for_temporal_cases": true,
    "other_relation_policy": "record as output failure"
  },
  "shacl_identity": [
    "sourceConstraintComponent",
    "focusNode",
    "resultPath",
    "value",
    "sourceShape"
  ],
  "owl_feedback": {
    "main_message": "The graph is logically inconsistent.",
    "controlled_focus_when_available": true,
    "include_explanation": false,
    "include_expected_repair": false,
    "later_unlocalized_inconsistency_focus": null
  },
  "validation_reconstruction": {
    "preserve_clean_background_types": true,
    "derive_new_background_types_from_repair": false,
    "restore_case_shapes": true,
    "restore_owl_context": true,
    "restore_cardinality_restriction": true,
    "preserve_temporal_hermit_date_handling": true,
    "grounding_content_only": true
  },
  "grounding_cache": {
    "seed_from_frozen_clean_and_injected_results": true,
    "judge_only_assertions_not_already_cached": true,
    "exclude_frozen_clean_unsupported_from_feedback": true,
    "shared_assertion_precedence": "injected_state",
    "clean_background_exclusion_source": "clean_state",
    "rerun_to_resolve_frozen_disagreement": false
  },
  "runner": {
    "path": "src/run_controlled_repair.py",
    "result_path": "results/controlled_repair_trajectories.jsonl",
    "store_rendered_prompt": true,
    "store_raw_model_response": true,
    "transport_failure_policy": "abort run; do not score as model failure",
    "preflight_only_mode": true
  }
}
